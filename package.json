{
  "name": "ogm-viewer",
  "version": "1.2.0",
  "description": "A web-based viewer for previewing OpenGeoMetadata records",
  "module": "./dist/components/ogm-viewer.js",
  "types": "./dist/components/ogm-viewer.d.ts",
  "unpkg": "./dist/components/ogm-viewer.js",
  "jsdelivr": "./dist/components/ogm-viewer.js",
  "exports": {
    ".": {
      "types": "./dist/components/ogm-viewer.d.ts",
      "import": "./dist/components/ogm-viewer.js"
    },
    "./lib": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./components/*": "./dist/components/*",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenGeoMetadata/ogm-viewer.git"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "assets": "node scripts/inline-assets.mjs",
    "prebuild": "npm run assets",
    "build": "stencil build",
    "prepare": "npm run build",
    "prestart": "npm run assets",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil-test",
    "test:unit": "stencil-test --project unit",
    "test:component": "stencil-test --project component",
    "test:www": "stencil-test --project www",
    "generate": "stencil generate",
    "lint": "tsc --noEmit && prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@stencil/core": "^4.43.4",
    "@stencil/playwright": "^0.4.3",
    "@stencil/vitest": "^1.11.6",
    "@types/d3-color": "^3.1.3",
    "@types/mapbox__geojson-extent": "^1.0.3",
    "@types/node": "^22.13.5",
    "@types/openseadragon": "^5.0.2",
    "@types/terraformer__wkt": "^2.0.3",
    "@vitest/coverage-v8": "^4.1.7",
    "happy-dom": "^20.9.0",
    "prettier": "^3.6.2",
    "rolldown": "^1.0.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "license": "MIT",
  "dependencies": {
    "@allmaps/maplibre": "^1.0.0-beta.43",
    "@awesome.me/webawesome": "^3.10.0",
    "@chunkd/middleware": "^11.3.0",
    "@chunkd/source": "^11.4.0",
    "@deck.gl/core": "^9.3.1",
    "@deck.gl/geo-layers": "^9.3.1",
    "@deck.gl/layers": "^9.3.1",
    "@deck.gl/mapbox": "^9.3.1",
    "@deck.gl/mesh-layers": "^9.3.1",
    "@developmentseed/deck.gl-geotiff": "^0.7.0",
    "@developmentseed/deck.gl-raster": "^0.7.0",
    "@developmentseed/geotiff": "^0.7.0",
    "@geomatico/maplibre-cog-protocol": "^0.9.0",
    "@iiif/presentation-2": "^1.0.4",
    "@iiif/presentation-3": "^2.2.3",
    "@luma.gl/core": "^9.3.3",
    "@mapbox/geojson-extent": "^1.0.1",
    "@terraformer/wkt": "^2.2.1",
    "autolinker": "^4.1.5",
    "d3-color": "^3.1.0",
    "d3-scale": "^4.0.2",
    "lerc": "^4.1.1",
    "maplibre-gl": "^5.24.0",
    "openseadragon": "^5.0.1",
    "pmtiles": "^4.4.1"
  }
}

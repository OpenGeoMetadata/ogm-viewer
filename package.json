{
  "name": "ogm-viewer",
  "version": "1.8.0",
  "description": "A web-based viewer for previewing OpenGeoMetadata records",
  "module": "./dist/components/ogm-viewer.js",
  "types": "./dist/components/ogm-viewer.d.ts",
  "unpkg": "./dist/components/ogm-viewer.js",
  "jsdelivr": "./dist/components/ogm-viewer.js",
  "exports": {
    ".": {
      "types": "./dist/components/ogm-viewer.d.ts",
      "import": "./dist/components/ogm-viewer.js"
    },
    "./lib": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./components/*": "./dist/components/*",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenGeoMetadata/ogm-viewer.git"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "assets": "node scripts/inline-assets.mjs",
    "prebuild": "npm run assets",
    "build": "stencil build",
    "prepare": "npm run build",
    "prestart": "npm run assets",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil-test",
    "test:unit": "stencil-test --project unit",
    "test:component": "stencil-test --project component",
    "test:www": "stencil-test --project www",
    "generate": "stencil generate",
    "lint": "tsc --noEmit && prettier --check ."
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@maplibre/maplibre-gl-style-spec": "^26.6.0",
    "@playwright/test": "^1.65.0",
    "@stencil/core": "^4.45.2",
    "@stencil/playwright": "^0.6.0",
    "@stencil/vitest": "^1.16.1",
    "@types/d3-color": "^3.1.3",
    "@types/mapbox__geojson-extent": "^1.0.3",
    "@types/node": "^24.19.2",
    "@types/polylabel": "^2.0.0",
    "@types/terraformer__wkt": "^2.0.3",
    "@vitest/coverage-v8": "^5.1.0",
    "happy-dom": "^21.0.4",
    "pbf": "^5.1.2",
    "prettier": "^3.9.10",
    "rolldown": "^1.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "dependencies": {
    "@allmaps/annotation": "^1.0.0-beta.38",
    "@allmaps/background-color": "^1.0.0-beta.2",
    "@allmaps/iiif-parser": "^1.0.0-beta.49",
    "@allmaps/maplibre": "^1.0.0-beta.44",
    "@awesome.me/webawesome": "^3.14.0",
    "@deck.gl/core": "^9.4.1",
    "@deck.gl/geo-layers": "^9.4.1",
    "@deck.gl/layers": "^9.4.1",
    "@deck.gl/maplibre": "^9.4.1",
    "@deck.gl/mesh-layers": "^9.4.1",
    "@developmentseed/deck.gl-geotiff": "0.10.0",
    "@developmentseed/deck.gl-raster": "0.10.0",
    "@developmentseed/geotiff": "0.10.0",
    "@developmentseed/range-reader": "0.10.0",
    "@iiif/presentation-2": "^1.0.4",
    "@iiif/presentation-3": "^2.2.4",
    "@luma.gl/core": "^9.4.2",
    "@mapbox/geojson-extent": "^1.2.0",
    "@maplibre/geojson-vt": "^6.3.0",
    "@maplibre/vt-pbf": "^4.3.3",
    "@terraformer/wkt": "^2.2.2",
    "autolinker": "^4.1.5",
    "d3-color": "^3.1.1",
    "d3-scale": "^4.0.3",
    "lerc": "^4.3.0",
    "maplibre-gl": "^6.17.0",
    "openseadragon": "^6.1.1",
    "pmtiles": "^4.5.0",
    "polylabel": "^2.1.0"
  }
}
